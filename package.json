{
  "name": "roundtable-clean",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "pnpm --filter @roundtable/desktop dev",
    "build": "next build",
    "build:workspaces": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "build:all": "pnpm run build:workspaces && pnpm run build",
    "start": "next start",
    "start:desktop": "pnpm --filter @roundtable/desktop start",
    "dev:postgres": "DATABASE_URL=postgres://roundtable:roundtable@localhost:5432/roundtable ROUNDTABLE_STORE_DRIVER=postgres_normalized pnpm dev",
    "typecheck": "tsc --noEmit",
    "typecheck:workspaces": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:desktop-smoke": "pnpm --filter @roundtable/desktop test:electron-smoke",
    "test:desktop-runtime-smoke": "pnpm --filter @roundtable/desktop test:runtime-electron-smoke",
    "test:macos:contracts": "swift test --package-path apps/macos",
    "test:macos:payload-fixtures": "pnpm --filter @roundtable/protocol exec vitest run tests/macos-host-runtime-payload-fixtures.test.ts",
    "test:macos:protocol": "pnpm --filter @roundtable/protocol test && pnpm --filter @roundtable/protocol typecheck",
    "verify:macos:turn-scenes": "tsx scripts/generate-turn-scenes.mjs apps/macos/Tests/Fixtures/TurnTimelines/feature-builder-local-dispatch.timeline.json --check && tsx scripts/generate-turn-scenes.mjs apps/macos/Tests/Fixtures/TurnTimelines/feature-builder-synthetic-live.timeline.json --check",
    "verify:macos:contracts": "pnpm --filter @roundtable/runtime exec node scripts/generate-service-uid-v1-contract.mjs --check && pnpm run verify:macos:turn-scenes && pnpm --filter @roundtable/protocol verify:macos-host-contract && pnpm run test:macos:protocol && pnpm run test:macos:contracts",
    "test:workspaces": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run test",
    "cli": "tsx src/cli/main.ts",
    "migrate:postgres": "tsx src/cli/migrate-json-to-postgres.ts",
    "migrate:postgres:jsonb": "ROUNDTABLE_TARGET_STORE_DRIVER=postgres tsx src/cli/migrate-json-to-postgres.ts",
    "db:up": "tsx src/cli/local-postgres.ts up",
    "db:down": "tsx src/cli/local-postgres.ts down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate:local": "DATABASE_URL=postgres://roundtable:roundtable@localhost:5432/roundtable ROUNDTABLE_TARGET_STORE_DRIVER=postgres_normalized pnpm migrate:postgres",
    "db:smoke:local": "DATABASE_URL=postgres://roundtable:roundtable@localhost:5432/roundtable ROUNDTABLE_STORE_DRIVER=postgres_normalized tsx src/cli/postgres-smoke.ts",
    "devrt:action": "tsx src/cli/devrt-action.ts",
    "memory:sim": "tsx src/cli/memory-sim.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.0.1",
    "@e2b/code-interpreter": "^2.6.1",
    "@tanstack/react-query": "^5.62.0",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "next": "^15.5.21",
    "next-auth": "^4.24.15",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "superjson": "^2.2.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^10.4.0",
    "tsx": "^4.22.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.12",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<8.5.23": "8.5.23",
      "sharp@<0.35.0": "0.35.0",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "tar@<=7.5.20": "7.5.21",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "uuid@<11.1.1": "11.1.1",
      "vite": "6.4.3"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
