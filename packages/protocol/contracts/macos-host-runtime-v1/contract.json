{
  "contract": "macos-host-runtime-v1",
  "version": 1,
  "transport": "authenticated-xpc",
  "maxRequestBytes": 1048576,
  "maxResponseBytes": 1048576,
  "maxEventBytes": 65536,
  "maxRequestsPerSecond": 8,
  "turnStream": {
    "actions": ["start", "poll", "approve", "accept", "stop"],
    "gates": ["plan_approval", "delivery_decision"],
    "maxRequestBytes": 16384,
    "maxResponseBytes": 1048576,
    "maxFrames": 64,
    "maxTurnBytes": 262144,
    "turnSchema": "roundtable-turn-v1",
    "replay": "connection-session-owner-bound"
  },
  "transportHandshake": {
    "requestKeys": ["protocolVersion", "clientNonce"],
    "responseKeys": ["protocolVersion", "sessionNonce"],
    "failureResponseKeys": ["error"],
    "maxRequestBytes": 256,
    "maxResponseBytes": 128,
    "clientNoncePattern": "^client_[a-f0-9]{32}$",
    "sessionNoncePattern": "^session_[a-f0-9]{32}$",
    "versionPolicy": "exact-match-before-dispatch",
    "versionMismatchError": "unsupported_protocol_version",
    "malformedRequestError": "invalid_handshake",
    "failureDisposition": "reply-then-invalidate-connection"
  },
  "operations": [
    "system.status",
    "workspace.register",
    "workspace.list",
    "runtime.catalog",
    "mission.prepare",
    "mission.approve",
    "execution.get",
    "execution.stop",
    "review.begin",
    "review.inspect",
    "review.prepare",
    "apply.authorize",
    "apply.reject"
  ],
  "requestPayloadKeySets": {
    "system.status": [],
    "workspace.register": ["bookmarkTransferId", "displayName"],
    "workspace.list": ["workspaceId", "relativePath"],
    "runtime.catalog": [],
    "mission.prepare": ["workspaceId", "provider", "prompt"],
    "mission.approve": ["approvalId"],
    "execution.get": ["executionId"],
    "execution.stop": ["executionId"],
    "review.begin": ["executionId", "workspaceId"],
    "review.inspect": ["executionId", "workspaceId"],
    "review.prepare": ["bundleId"],
    "apply.authorize": ["applyId"],
    "apply.reject": ["applyId"]
  },
  "responsePayloadKeySets": {
    "system.status": ["product", "applicationVersion", "platform", "architecture", "capabilities", "runtimeAvailability"],
    "workspace.register": ["workspace"],
    "workspace.list": ["workspace", "relativePath", "entries", "truncated"],
    "runtime.catalog": ["providers"],
    "mission.prepare": ["approvalId", "missionId", "workspace", "provider", "prompt", "policy", "warnings", "expiresAt"],
    "mission.approve": ["missionId", "executionId", "state"],
    "execution.get": ["missionId", "executionId", "workspace", "provider", "state", "sequence", "startedAt", "finishedAt", "error", "summary", "treeTermination", "logs", "artifacts"],
    "execution.stop": ["missionId", "executionId", "workspace", "provider", "state", "sequence", "startedAt", "finishedAt", "error", "summary", "treeTermination", "logs", "artifacts"],
    "review.begin": ["started"],
    "review.inspect": ["version", "bundleId", "executionId", "workspaceId", "workspace", "staging", "protectedDirectoryNames", "protectedPaths", "baselineHash", "resultHash", "changes", "contentHash"],
    "review.prepare": ["applyId", "bundleId", "executionId", "workspaceId", "baselineHash", "contentHash", "expiresAt"],
    "apply.authorize": ["applied"],
    "apply.reject": ["rejected"]
  },
  "events": ["execution.event"],
  "commonRequestKeys": ["protocolVersion", "requestId", "sessionNonce", "operation", "payload"],
  "commonResponseKeys": ["protocolVersion", "requestId", "operation", "ok", "payload", "error"],
  "eventKeys": ["protocolVersion", "sessionNonce", "event", "sequence", "payload"],
  "eventPayloadKeySets": {
    "execution.event.state": ["missionId", "executionId", "sequence", "occurredAt", "type", "state", "error", "treeTermination"],
    "execution.event.output": ["missionId", "executionId", "sequence", "occurredAt", "type", "stream", "text", "truncated"],
    "execution.event.artifact": ["missionId", "executionId", "sequence", "occurredAt", "type", "artifact"]
  },
  "providers": ["codex", "claude-code", "opencode"],
  "executionStates": ["queued", "starting", "running", "stopping", "succeeded", "failed", "stopped", "timed_out"],
  "treeTerminationStates": ["not-required", "pending", "confirmed", "failed"],
  "runtimeAvailabilityStates": ["initializing", "ready", "unavailable", "quarantined"],
  "runtimeAvailabilityReasons": [
    "initializing",
    "ready",
    "state_migration_required",
    "state_migration_failed",
    "state_version_unsupported",
    "state_quarantined",
    "broker_unavailable",
    "broker_identity_unverified",
    "service_identity_unavailable",
    "seat_cleanup_unconfirmed"
  ],
  "runtimeAdmissionStates": ["closed", "open", "busy"],
  "runtimeAvailabilityTupleKeys": [
    "initializing|initializing|closed",
    "ready|ready|open",
    "ready|ready|busy",
    "unavailable|state_migration_required|closed",
    "unavailable|state_version_unsupported|closed",
    "unavailable|broker_unavailable|closed",
    "unavailable|broker_identity_unverified|closed",
    "unavailable|service_identity_unavailable|closed",
    "quarantined|state_migration_failed|closed",
    "quarantined|state_quarantined|closed",
    "quarantined|seat_cleanup_unconfirmed|closed"
  ],
  "hostRuntimeStateSchemaVersion": 1,
  "workspaceTransfer": "security-scoped-bookmark-data",
  "workspaceTransferBinding": "single-xpc-data-attachment-by-transfer-id",
  "secretVisibility": "host-runtime-only",
  "forbiddenPayloadKeys": [
    "credential",
    "environment",
    "hostHome",
    "providerSecret",
    "rootCommand",
    "serviceUid",
    "signalTarget"
  ]
}
